NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Image generation, via MuAPI. Required by the create flow and by
# `node scripts/generate-designs.ts`, which is what fills the catalogue —
# there is no seed file any more, every design is really generated.
#
# One key covers all three models a design needs: gpt-image-2-text-to-image
# draws it, ai-background-remover cuts the background off so it prints as ink
# and not as a rectangle, and kimi-k3 names the design and writes the
# Subject / Composition / Art direction of its image prompt.
#
# The backdrop, exact typography and negative constraints are NOT model-written
# — they stay in lib/generation/prompt.ts, because they are the chroma key and
# the letterform ban, not style. If kimi-k3 fails or times out, the template
# builds the prompt exactly as it did before and the title falls back to the
# first few words of the idea.
#
# Key from muapi.ai → Dashboard → API Keys.
MUAPI_API_KEY=

# Printify — optional. Leave blank and the app runs exactly as before: designs
# show the drawn mockup and no products are created. Fill all four in and a
# claimed design gets a real Printify product plus a photographic mockup.
#
# Run `node scripts/printify-catalog.mjs` with the token set to print your shop
# id and the blueprint / print-provider / variant ids for a garment.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_BLUEPRINT_ID=
PRINTIFY_PRINT_PROVIDER_ID=
# PRINTIFY_VARIANT_IDS was removed: a product now carries every variant the
# print provider offers, because the buyer picks colour and size at checkout.

# Bolt — required to sell a *priced* design. Leave blank and free designs still
# work exactly as before; a priced one refuses with "Card payments aren't
# switched on yet" rather than pretending to charge.
#
# All four come from the Bolt Merchant Dashboard → Administration → API. The
# publishable key is NEXT_PUBLIC_ because the browser needs it to load the
# checkout modal; the API key and signing secret are server-only and must never
# be prefixed that way.
#
# BOLT_SIGNING_SECRET verifies the webhook you point at /api/bolt/webhook
# (Administration → Developers → Webhooks). Subscribe to `payment`, `auth` and
# `capture` — those are the events that mean money is committed.
#
# BOLT_ENV defaults to sandbox. Set it to "production" only when you mean to
# charge real cards; getting this wrong on a dev branch takes real money.
BOLT_API_KEY=
BOLT_SIGNING_SECRET=
NEXT_PUBLIC_BOLT_PUBLISHABLE_KEY=
BOLT_ENV=
NEXT_PUBLIC_BOLT_ENV=

# Only if Bolt's checkout scripts (track.js, connect.js) live somewhere other
# than the default this code assumes — check the install snippet in your
# merchant dashboard and set this if it differs. Leave blank otherwise.
NEXT_PUBLIC_BOLT_CDN_URL=

# Email — required to deliver a receipt and the design file. Without it a
# purchase completes and logs a warning instead of sending anything.
#
# EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Stopgap while the domain isn't verified in Resend: set both and mail goes out
# through Gmail's SMTP instead, taking priority over RESEND_API_KEY.
#
# GMAIL_APP_PASSWORD is an App Password (16 characters, from
# myaccount.google.com/apppasswords), not the account password — Google refuses
# plain password auth on SMTP, and App Passwords need 2-Step Verification on.
#
# Temporary on purpose: Gmail caps a normal account at a few hundred messages a
# day and rewrites the From header to GMAIL_USER whatever EMAIL_FROM says.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The public origin. Stripe redirects back to it and the receipt links to it,
# so it must be right in production — the localhost fallback is dev only.
#
# NEXT_PUBLIC_, so it is baked in at build time, not read at runtime: changing
# it on the host needs a redeploy before anything picks it up. Currently
# https://bazaar-jet.vercel.app while the real domain is pending.
#
# Leave it blank locally. Setting it to the deployed origin in .env.local sends
# your dev Stripe redirects to production.
NEXT_PUBLIC_SITE_URL=

# Set to "true" to actually send orders to Printify. OFF by default, and it must
# stay off until real payment lands: payment is currently a mock adapter, so
# submitting would manufacture a garment and ship it to a real address against
# money that never moved.
PRINTIFY_SUBMIT_ORDERS=
